<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/pageContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include
                android:id="@+id/pageFeed"
                layout="@layout/page_feed" />

            <include
                android:id="@+id/pageHome"
                layout="@layout/page_home"
                android:visibility="gone" />

            <include
                android:id="@+id/pageLibrary"
                layout="@layout/page_library"
                android:visibility="gone" />

            <include
                android:id="@+id/pageHistory"
                layout="@layout/page_history"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 迷你播放条 -->
        <LinearLayout
            android:id="@+id/miniPlayer"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_mini_player"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvMiniCover"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="听"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMiniTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="正在播放"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvMiniMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnMiniPlay"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_circle_accent"
                android:contentDescription="播放"
                android:padding="10dp"
                android:src="@drawable/ic_pause" />
        </LinearLayout>

        <!-- 底部标签栏 -->
        <LinearLayout
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:background="@drawable/bg_nav"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/navFeed"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/icNavFeed"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="发现"
                    android:src="@drawable/ic_discover"
                    android:tint="@color/accent" />

                <TextView
                    android:id="@+id/tvNavFeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="发现"
                    android:textColor="@color/accent"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navParse"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/icNavParse"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="解析"
                    android:src="@drawable/ic_link"
                    android:tint="@color/text_tertiary" />

                <TextView
                    android:id="@+id/tvNavParse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="解析"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navLibrary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/icNavLibrary"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="曲库"
                    android:src="@drawable/ic_library"
                    android:tint="@color/text_tertiary" />

                <TextView
                    android:id="@+id/tvNavLibrary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="曲库"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navHistory"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/icNavHistory"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="历史"
                    android:src="@drawable/ic_history"
                    android:tint="@color/text_tertiary" />

                <TextView
                    android:id="@+id/tvNavHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="历史"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
